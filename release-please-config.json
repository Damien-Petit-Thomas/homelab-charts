{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "helm",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "bootstrap-sha": "5cf27a96687409b4b1b3053b001d985c4e56176c",
  "separate-pull-requests": false,
  "always-update": true,
  "pull-request-title-pattern": "chore: release${component} ${version}",
  "group-pull-request-title-pattern": "chore: release charts",
  "packages": {
    "charts/homelab-common": {
      "component": "homelab-common"
    },
    "charts/vaultwarden": {
      "component": "vaultwarden"
    },
    "charts/homelab-policies": {
      "component": "homelab-policies"
    }
  }
}
